# Supabase — copy to .env.local and fill in.
# The anon key is public by design: every rule that matters is enforced in Postgres
# (RLS + security-definer RPCs). Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev-only OTP backdoor. MUST be false in production — main.tsx refuses to boot
# with it enabled unless MODE is development.
VITE_DEV_OTP_MODE=false
